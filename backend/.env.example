MONGODB_URI=<your-mongodb-atlas-connection-string>
DATABASE_NAME=retail-supply-chain-risk
APP_NAME=retail-supply-chain-risk
LLM_API_KEY=<your-llm-api-key>
LLM_BASE_URL=<your-llm-base-url>
ANTHROPIC_MODEL=claude-opus-4-7
# VOYAGE_API_KEY isn't read anywhere in the app code — Voyage is called
# natively from Atlas (autoEmbed + $rerank), configured via a project-level
# Model API key in Atlas itself, not this env var. The field is still
# required to start the app (no default), so something must be set here.
VOYAGE_API_KEY=<your-voyage-api-key>
CORS_ORIGINS=*
