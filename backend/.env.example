MONGODB_URI=<your-mongodb-atlas-connection-string>
DATABASE_NAME=retail-supply-chain-risk
APP_NAME=retail-supply-chain-risk
LLM_API_KEY=
LLM_BASE_URL=
ANTHROPIC_MODEL=claude-opus-4-7
# Optional — external rerank fallback for alternative_finder.
# ONLY used when the native in-database $rerank stage is unavailable on the configured
# cluster (server rejects the stage at parse time with OperationFailure code 40324).
# When this is unset, the pipeline simply serves the $rankFusion fused order unranked.
# Get this key from the Voyage AI dashboard — NOT from MongoDB Atlas.
# Note: unlike VOYAGE_API_KEY (consumed by Atlas itself for autoEmbed), this one IS read
# by application code and results in document text being sent to an external API.
VOYAGE_API_KEY_FALLBACK=
CORS_ORIGINS=*
