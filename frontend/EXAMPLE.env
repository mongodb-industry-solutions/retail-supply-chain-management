# Remember to update your demo name in the appName option
MONGODB_URI="<your-mongodb-string>"
DATABASE_NAME="<your-database-name>"
BACKEND_URL=

# Atlas Charts — base URL includes your Charts project slug
ATLAS_CHARTS_BASE_URL="https://charts.mongodb.com/charts-<your-project-id>"
ATLAS_DASHBOARD_ID="<your-dashboard-id>"
